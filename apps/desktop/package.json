{
  "name": "@cdmm/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Run several Claude Max accounts in the official Claude Desktop on Windows",
  "author": "masseater",
  "type": "module",
  "main": "dist/main/index.mjs",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "vp pack && vp build",
    "dist": "vp pack && vp build && electron-builder --win --x64",
    "start": "vp pack && vp build && electron .",
    "test": "vp test run",
    "steiger": "steiger ./src",
    "fallow": "fallow --production --quiet --format compact && fallow dupes --quiet --format compact && fallow security --fail-on-issues --quiet"
  },
  "dependencies": {
    "@cdmm/core": "workspace:*",
    "@effect/atom-react": "catalog:stack",
    "@effect/platform-node": "catalog:",
    "@tanstack/react-query": "catalog:stack",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "effect": "catalog:stack",
    "radix-ui": "catalog:stack",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "catalog:stack",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:stack",
    "@feature-sliced/steiger-plugin": "0.8.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "steiger": "catalog:stack",
    "typescript": "catalog:stack",
    "vite": "catalog:",
    "vite-plus": "catalog:stack"
  }
}
